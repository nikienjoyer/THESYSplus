# THESYS+ Authentication Module — backend env file
# Copy this file to ``backend/.env`` and fill in real values for local
# development. The root ``.gitignore`` ensures ``.env`` is never committed.
#
# All variables here are read by ``backend/thesys/settings/base.py`` via
# ``django-environ``. ``read_env`` falls back to the values below when the
# file is missing, so nothing here is strictly required for ``manage.py
# check`` — but every value SHOULD be set explicitly before running
# ``manage.py runserver`` against a real PostgreSQL instance.

# ---------------------------------------------------------------------------
# Django runtime
# ---------------------------------------------------------------------------

# ``development`` selects ``thesys.settings.dev`` (DEBUG on, ALLOWED_HOSTS=*).
# ``production``  selects ``thesys.settings.prod`` (DEBUG off, hosts from env).
DJANGO_ENV=development

# Long random string used to sign sessions, CSRF tokens, and password reset
# tokens. The dev fallback in ``base.py`` is INSECURE and clearly marked.
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-in-development-too

# Comma-separated list, only consumed in production (``thesys.settings.prod``).
# Leave commented in development; ``dev.py`` already sets ALLOWED_HOSTS=['*'].
# DJANGO_ALLOWED_HOSTS=thesys.example.com,api.thesys.example.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
#
# Primary mechanism: a single connection URL. ``django-environ``'s
# ``db_url`` helper accepts the standard ``postgres://`` form.
DATABASE_URL=postgres://thesys:thesys@localhost:5432/thesys

# Fallback (used only when DATABASE_URL is unset): discrete vars that
# build the same DATABASES dict. Either approach is fine — pick one.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thesys
POSTGRES_USER=thesys
POSTGRES_PASSWORD=thesys

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
#
# Comma-separated list of origins allowed to call the API with credentials.
# The default Vite dev server runs on port 5173.
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# JWT (access tokens)
# ---------------------------------------------------------------------------
#
# Distinct from ``DJANGO_SECRET_KEY`` so rotating the JWT key does NOT
# invalidate sessions. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-distinct-jwt-secret
JWT_KID=kid-2025-01

# ---------------------------------------------------------------------------
# Email backend
# ---------------------------------------------------------------------------
# ``console`` writes emails to the Django terminal (dev default).
# ``smtp`` sends real emails via SMTP (requires SMTP_* vars below).
#
# If EMAIL_BACKEND=smtp but SMTP credentials are missing/empty, the system
# automatically falls back to console mode with a warning — so development
# never breaks.
EMAIL_BACKEND=console
EMAIL_FROM=noreply@pampangastateu.edu.ph

# ---------------------------------------------------------------------------
# SMTP configuration (only used when EMAIL_BACKEND=smtp)
# ---------------------------------------------------------------------------
# For Gmail SMTP (recommended for local testing):
#   1. Enable 2-Step Verification on your Google account.
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password below (NOT your Gmail password).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_USE_TLS=True
#
# For production (e.g. SendGrid, Mailgun, SES):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxx
# SMTP_USE_TLS=True

# ---------------------------------------------------------------------------
# Frontend base URL (used to render reset/activation links in emails)
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
