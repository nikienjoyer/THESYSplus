# THESYS+ Authentication Module — Frontend environment variables
# Copy this file to ``frontend/.env`` and adjust values for your local setup.
# The root ``.gitignore`` ensures ``.env`` is never committed.

# Base URL for the backend API. MUST include the ``/api/v1`` prefix that the
# Django root URLConf mounts all endpoints under. When this uses localhost,
# the frontend automatically substitutes the hostname used in the browser URL,
# so LAN access continues to work when the machine's Wi-Fi IP changes.
VITE_API_BASE_URL=http://localhost:8000/api/v1
